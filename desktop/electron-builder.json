{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.xxq.chat.desktop",
  "productName": "XXQ Chat",
  "copyright": "Copyright © 2026 XXQ Chat Team",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "web/**/*"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "CodingM-eng",
      "repo": "XXQ-Chat"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "XXQ Chat",
    "uninstallDisplayName": "XXQ Chat",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "artifactName": "XXQ-Chat-Setup.exe"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Network;Chat;InstantMessaging",
    "maintainer": "XXQ Chat Team <dev@xxqchat.com>",
    "executableName": "xxq-chat",
    "synopsis": "XXQ Chat Güvenli ve Gerçek Zamanlı Mesajlaşma",
    "description": "XXQ Chat modern, güvenli ve gerçek zamanlı masaüstü mesajlaşma istemcisi"
  }
}
