{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.xxq.chat.desktop",
  "productName": "XXQ Chat",
  "copyright": "Copyright © 2026 XXQ Chat Team",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*",
    "web/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "XXQ Chat",
    "uninstallDisplayName": "XXQ Chat",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "artifactName": "XXQ-Chat-Setup.exe"
  }
}
