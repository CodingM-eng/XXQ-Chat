# XXQ Chat Server Environment Configuration

# Server Port and Environment
PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated, or * in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:4000,http://localhost:3000

# Security and Whitelist Configuration
# Initial designated administrator email
INITIAL_ADMIN_EMAIL=codingdevelopia@gmail.com

# Default whitelist mode on first boot (true = Whitelist ON, false = Open)
WHITELIST_MODE_DEFAULT=true

# Database Driver Selection:
# 'auto' (default) -> Uses Firestore if FIREBASE_PROJECT_ID is provided; falls back to SQLite
# 'sqlite' -> Force local SQLite file database (best for zero-dependency local dev/tests)
# 'firestore' -> Force Firebase Cloud Firestore (used on Render Free Tier for 100% no-cost persistence)
DB_DRIVER=auto

# Local SQLite database storage path (used when DB_DRIVER=sqlite or auto fallback)
DB_PATH=./data/xxq-chat.db

# Development JWT Secret (used when Firebase Admin credentials are not provided)
JWT_DEV_SECRET=dev-xxq-chat-secret-key-change-in-production-min-32-chars

# Firebase Admin Service Account Credentials (Required for Render Production Firestore & Token Verification)
# 1. Download Service Account JSON from Firebase Console > Project Settings > Service Accounts
# 2. Add these variables to your Render Web Service Environment (NEVER commit secrets to Git):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backend Base URL (Used for generating Telegram webhook URLs and Google Drive OAuth callbacks)
SERVER_BASE_URL=https://xxq-chat-backend.onrender.com

# AES-256 Encryption Key (32-character string for encrypting Telegram bot tokens and Drive credentials at rest)
ENCRYPTION_KEY=your-32-character-encryption-key-here-123456

# Google Drive Cloud Storage (Optional - user files stored in admin Drive via least-privilege drive.file scope)
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://xxq-chat-backend.onrender.com/api/drive/callback

