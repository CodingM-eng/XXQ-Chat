# XXQ Chat Server Environment Configuration

# Server Port and Environment
PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated, or * in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:4000,http://localhost:3000

# Security and Whitelist Configuration
# Initial designated administrator email
INITIAL_ADMIN_EMAIL=admin@xxqchat.com

# Default whitelist mode on first boot (true = Whitelist ON, false = Open)
WHITELIST_MODE_DEFAULT=true

# Database storage path
DB_PATH=./data/xxq-chat.db

# Development JWT Secret (used when Firebase Admin credentials are not provided)
JWT_DEV_SECRET=dev-xxq-chat-secret-key-change-in-production-min-32-chars

# Firebase Admin Configuration (Optional for local dev, Required for production Firebase Auth)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
