# ==============================================================================
# XXQ Chat - Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS, PRIVATE KEYS, OR TOKENS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env or Render Environment Variables)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://xxq-chat-frontend.onrender.com
INITIAL_ADMIN_EMAIL=codingdevelopia@gmail.com
WHITELIST_MODE_DEFAULT=true

# Database Persistence:
# Use 'firestore' on Render Free (ephemeral disk safe).
# Use 'sqlite' for local development or testing.
DB_DRIVER=firestore
DB_PATH=./data/xxq-chat.db

# Security & Encryption:
# JWT_DEV_SECRET: Used for session tokens and development mode.
JWT_DEV_SECRET=change-this-to-a-very-secure-random-32-char-string-in-production
# ENCRYPTION_KEY: Used for AES-256-GCM encryption of Google Drive refresh tokens & Telegram bot tokens.
ENCRYPTION_KEY=change-this-to-a-strong-secret-key-at-least-32-chars-long

# Server Base URL (Used for registering Telegram Webhooks and OAuth callbacks)
SERVER_BASE_URL=https://xxq-chat-backend.onrender.com

# Firebase Admin SDK (Cloud Firestore Production Persistence)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=xxq-chat
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@xxq-chat.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Drive Integration (Least-privilege drive.file scope)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://xxq-chat-backend.onrender.com/api/drive/callback

# ------------------------------------------------------------------------------
# Web Frontend Configuration (web/.env or Render Static Site Environment Variables)
# ------------------------------------------------------------------------------
VITE_API_URL=https://xxq-chat-backend.onrender.com
VITE_FIREBASE_API_KEY=AIzaSyCCk8A6picstXW0qSMCXB75tAuj47BfJps
VITE_FIREBASE_AUTH_DOMAIN=xxq-chat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=xxq-chat
VITE_FIREBASE_STORAGE_BUCKET=xxq-chat.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=361932070636
VITE_FIREBASE_APP_ID=1:361932070636:web:086c009ce9f7fb68998fc9
